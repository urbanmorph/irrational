---
// Hidden until the browser offers install (Chrome/Edge/Android) or on iPhone/iPad
// Safari, where it opens a "Share -> Add to Home Screen" guide. See install-button.ts.
---

<button id="install-app" class="install-btn" type="button" hidden>Install app</button>

<script>
  import { mountInstallButton } from '../install/install-button';
  mountInstallButton(document.getElementById('install-app') as HTMLButtonElement | null, {
    appName: 'Irrational',
  });
</script>

<style>
  .install-btn {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 7px;
    padding: 6px 12px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .install-btn[hidden] {
    display: none;
  }
  .install-btn:hover,
  .install-btn:focus-visible {
    color: var(--color-vermilion);
    border-color: var(--color-vermilion);
  }

  /* The iOS guide dialog is created at runtime, so its rules are global.
     Tailwind's preflight zeroes dialog margins and list markers; restore them. */
  :global(.install-guide) {
    margin: auto;
    max-width: min(26rem, calc(100vw - 32px));
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: 11px;
    box-shadow: 0 18px 44px -22px rgba(26, 23, 20, 0.45);
    padding: 24px 24px 20px;
    font-family: var(--font-body);
    line-height: 1.5;
  }
  :global(.install-guide::backdrop) {
    background: rgba(26, 26, 24, 0.45);
  }
  :global(.install-guide h2) {
    font-size: 1.35rem;
    margin-bottom: 12px;
  }
  :global(.install-guide ol) {
    list-style: decimal;
    margin: 0 0 18px;
    padding-left: 1.2em;
  }
  :global(.install-guide li + li) {
    margin-top: 6px;
  }
  :global(.install-guide form) {
    text-align: right;
  }
  :global(.install-guide button) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    background: var(--color-vermilion);
    color: #fff;
    border: 0;
    border-radius: 8px;
    padding: 10px 18px;
    cursor: pointer;
  }
  :global(.install-guide button:hover) {
    background: #c5391f;
  }
</style>
