---
// Shown by the offline worker (src/sw/sw.js) for a page that isn't saved on this device.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Offline · Irrational" description="You are offline." noindex>
  <section class="page-head">
    <div class="wrap">
      <p class="label">Offline</p>
      <h1>No connection.</h1>
      <p class="lede">
        This page isn't saved on this device, but the rest of Irrational is. The
        <a href="/biases">field guide</a>, the checklist and the worked examples all read offline.
      </p>
    </div>
  </section>
</Layout>
