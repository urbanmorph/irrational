---
import Layout from '../layouts/Layout.astro';
import { BIASES, FAMILIES, type Family } from '../data/biases';
import { CHECKLIST } from '../data/checklist';

const families = Object.keys(FAMILIES) as Family[];
const [system, name, outside, premortem, questions, recal] = CHECKLIST.steps;
const step = (n: number, s: { title: string }) => `${n} · ${s.title}`;
---

<Layout
  title="The pen-and-paper audit · Irrational"
  description="A printable one-page bias audit. Run the same adversarial check on any decision with nothing but a pen, no app, no AI, no account."
>
  <section class="page-head no-print">
    <div class="wrap">
      <p class="label">Offline</p>
      <h1>The pen-and-paper audit.</h1>
      <p class="lede">
        The whole method runs on paper, no app, no AI, no account. Print this, keep it in a notebook, and walk any
        decision through the same adversarial check the engine performs.
      </p>
      <button class="print-btn" onclick="window.print()">Print / Save as PDF →</button>
    </div>
  </section>

  <!-- The sheet itself, styled for print; the frame gives it the page gutter. -->
  <div class="wrap sheet-frame">
  <article class="sheet">
    <header class="sheet-head">
      <div>
        <div class="mark-row">
          <svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
            <rect width="64" height="64" fill="#1a1a18"></rect>
            <rect x="27" y="27" width="10" height="24" rx="5" fill="#ffffff"></rect>
            <circle cx="32" cy="16.5" r="5.5" fill="#e2452c"></circle>
          </svg>
          <span class="sheet-title">{CHECKLIST.title}</span>
        </div>
        <p class="sheet-sub">{CHECKLIST.subtitle}</p>
      </div>
      <div class="meta">
        <p>Decision <span class="rule-line"></span></p>
        <p>Date <span class="rule-line short"></span></p>
      </div>
    </header>

    <ol class="steps">
      <li>
        <h3>{step(1, system)}</h3>
        <p class="hint">{system.hint}</p>
        <div class="opts">
          {system.options?.map((o) => <label><span class="box"></span> {o}</label>)}
        </div>
      </li>

      <li>
        <h3>{step(2, name)}</h3>
        <p class="hint">{name.hint}</p>
        <div class="fam-grid">
          {
            families.map((fam) => (
              <div class="fam-block" style={`--edge:${FAMILIES[fam].color}`}>
                <p class="fam-name">{FAMILIES[fam].label}</p>
                {BIASES.filter((b) => b.family === fam).map((b) => (
                  <label class="bias-row">
                    <span class="box"></span>
                    <span class="bias-name">{b.name}</span>
                  </label>
                ))}
              </div>
            ))
          }
        </div>
        <p class="evidence-label">{CHECKLIST.evidenceLabel}</p>
        <span class="rule-line full"></span>
        <span class="rule-line full"></span>
      </li>

      <li>
        <h3>{step(3, outside)}</h3>
        <p class="hint">{outside.hint}</p>
        <span class="rule-line full"></span>
        <span class="rule-line full"></span>
      </li>

      <li>
        <h3>{step(4, premortem)}</h3>
        <p class="hint">{premortem.hint}</p>
        <span class="rule-line full"></span>
        <span class="rule-line full"></span>
      </li>

      <li>
        <h3>{step(5, questions)}</h3>
        <ul class="qlist">
          {questions.questions?.map((q) => <li>{q}</li>)}
        </ul>
      </li>

      <li>
        <h3>{step(6, recal)}</h3>
        <p class="hint">{recal.hint}</p>
        <span class="rule-line full"></span>
        <span class="rule-line full"></span>
        <p class="confidence">{CHECKLIST.confidenceLabel} <span class="conf-box"></span> %</p>
      </li>
    </ol>

    <footer class="sheet-foot">
      {CHECKLIST.footer.map((f) => <span>{f}</span>)}
    </footer>
  </article>
  </div>
</Layout>

<style>
  .lede {
    max-width: 56ch;
  }
  .print-btn {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    background: var(--color-vermilion);
    color: #fff;
    border: 0;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
  }
  .print-btn:hover {
    background: #c5391f;
  }

  /* ── The printable sheet ──────────────────────────────────────────────────── */
  .sheet {
    max-width: 820px;
    margin: 28px auto 0;
    background: #fff;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    padding: 38px 44px 30px;
    color: #1a1a18;
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-bottom: 2px solid #1a1a18;
    padding-bottom: 16px;
  }
  .mark-row {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .sheet-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
  }
  .sheet-sub {
    margin: 7px 0 0;
    font-size: 0.92rem;
    color: #4a423b;
    max-width: 46ch;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-taupe);
    min-width: 210px;
  }
  .meta p {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 10px;
  }
  .rule-line {
    flex: 1;
    border-bottom: 1px solid #c9bfae;
    height: 1.1em;
    display: block;
  }
  .rule-line.short {
    max-width: 120px;
  }
  .rule-line.full {
    display: block;
    width: 100%;
    margin-top: 13px;
  }

  .steps {
    list-style: none;
    counter-reset: none;
    margin: 0;
    padding: 0;
  }
  .steps > li {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-rule);
    break-inside: avoid;
  }
  .steps h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 5px;
  }
  .hint {
    margin: 0 0 12px;
    font-size: 0.9rem;
    color: #4a423b;
    max-width: 64ch;
  }
  .opts label,
  .bias-row {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.92rem;
    padding: 4px 0;
    cursor: default;
  }
  .box {
    width: 14px;
    height: 14px;
    border: 1.5px solid #1a1a18;
    border-radius: 3px;
    flex: none;
    display: inline-block;
  }

  .fam-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 28px;
  }
  .fam-block {
    border-left: 3px solid var(--edge);
    padding-left: 12px;
    break-inside: avoid;
  }
  .fam-name {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--edge);
    font-weight: 600;
    margin: 0 0 6px;
  }
  .bias-name {
    line-height: 1.2;
  }
  .evidence-label {
    margin: 16px 0 0;
    font-size: 0.9rem;
    color: #4a423b;
  }

  .qlist {
    margin: 0;
    padding-left: 18px;
  }
  .qlist li {
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 6px 0;
  }
  .confidence {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }
  .conf-box {
    display: inline-block;
    width: 56px;
    border-bottom: 1px solid #1a1a18;
  }

  .sheet-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-taupe);
  }

  @media (max-width: 600px) {
    .fam-grid {
      grid-template-columns: 1fr;
    }
    .sheet {
      padding: 26px 22px;
    }
  }

  /* ── Print ────────────────────────────────────────────────────────────────── */
  @media print {
    :global(body::before),
    :global(.site-nav),
    :global(.site-footer),
    .no-print {
      display: none !important;
    }
    :global(body) {
      background: #fff;
    }
    .sheet-frame {
      padding-inline: 0;
    }
    .sheet {
      max-width: none;
      margin: 0;
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .steps > li {
      padding: 12px 0;
    }
    @page {
      margin: 14mm;
    }
  }
</style>
