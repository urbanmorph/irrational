{
  "name": "irrational",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node18 --banner:js='#!/usr/bin/env node' --outfile=cli/dist/irrational.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check . && astro check",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20240909.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.7",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.100.0"
  }
}
